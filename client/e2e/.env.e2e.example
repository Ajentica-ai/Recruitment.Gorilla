# Template for client/e2e/.env.e2e (which is gitignored — never commit the real one).
# Copy to .env.e2e and fill in the local demo-account password.

# Used by e2e/smoke.spec.ts. Recruiter is the least-privileged role that still
# sees the Candidates nav link (navRoutes.ts gates it on canWriteCandidates).
E2E_EMAIL=demo.recruiter@rg.local
E2E_PASSWORD=<local demo password>

# The @rg.local demo accounts share one password. Dev-only fixtures, no human uses them:
#   demo.admin@rg.local        Admin        — admin-only surfaces (Configuration, Audit)
#   demo.recruiter@rg.local    Recruiter    — role-scoped candidate access
#   demo.interviewer@rg.local  Interviewer  — dashboard-only, assigned interviews
#   demo.intv.a@rg.local       Interviewer  — peer-evaluation visibility, A of a pair
#   demo.intv.b@rg.local       Interviewer  — peer-evaluation visibility, B of a pair
DEMO_PASSWORD=<local demo password>

# Super Admin fixture. The Users page is [Authorize(Roles = SuperAdmin)], and none of
# the accounts above can open it. Seed one without touching the real admin row:
#   Auth__SeedAdminEmail=demo.superadmin@rg.local Auth__SeedAdminName="Demo Super Admin" dotnet run
SUPERADMIN_EMAIL=demo.superadmin@rg.local
SUPERADMIN_PASSWORD=***

# Used by e2e/responsive-card-header.spec.ts (issue #72). The interview page is
# the only surface whose card actions are wide enough to crush the title, so the
# test needs an interview the E2E_EMAIL user can open. Unset = that check skips.
E2E_INTERVIEW_ID=***
