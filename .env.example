# Copy to `.env` beside docker-compose.yml to override any default.
#
# You do not need this file to start: `docker compose up --build` runs with
# working defaults. You DO need it before putting the stack anywhere other than
# your own machine — the defaults are published in docker-compose.yml, so they
# are not secrets.

# ---- Database -------------------------------------------------------------
DB_NAME=recruitment_gorilla
DB_USER=rg
DB_PASSWORD=rg_dev_password
DB_ROOT_PASSWORD=rg_dev_root_password

# ---- Where the app is reached ---------------------------------------------
# The published port, and the origin the API is told to expect.
PUBLIC_PORT=8090
PUBLIC_ORIGIN=http://localhost:8090

# ---- Secrets --------------------------------------------------------------
# Jwt__Key must be at least 32 bytes or the API refuses to start.
#   openssl rand -base64 48
JWT_KEY=

# Encrypts the SMTP password at rest. Changing it after any secret has been
# saved makes that secret undecryptable — treat it as permanent per deployment.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ---- First Super Admin ----------------------------------------------------
# Seeded once, only while the Users table is empty. If it is already seeded,
# changing the hash here updates that user's password on the next start.
#
# PBKDF2-SHA256, formatted "iterations.saltBase64.hashBase64" — the format in
# server/Recruitment.Gorilla.API/Auth/PasswordHasher.cs. The compose default is
# the password "admin"; replace it for anything but local use.
SEED_ADMIN_EMAIL=admin@recruitmentgorilla.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD_HASH=

# ---- Runtime --------------------------------------------------------------
# Read the note in docker-compose.yml before setting this to Production: the
# refresh cookie becomes Secure and is dropped over plain HTTP, so sessions end
# after 15 minutes. Put TLS in front first.
ASPNETCORE_ENVIRONMENT=Development
